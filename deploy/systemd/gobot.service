[Unit]
Description=GoBot IRC Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# These placeholders are filled by scripts/install-systemd.sh.
User=@GOBOT_USER@
Group=@GOBOT_GROUP@

WorkingDirectory=@GOBOT_DIR@
EnvironmentFile=-@GOBOT_DIR@/.env
ExecStart=@GOBOT_DIR@/bin/irc-bot

Restart=on-failure
RestartSec=10
UMask=0077

# Send logs to journald.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
