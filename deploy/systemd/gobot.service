[Unit]
Description=GoBot IRC Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace these with the user/group that should run the bot.
User=gobot
Group=gobot

# Replace /opt/gobot with the directory where this repository is deployed.
WorkingDirectory=/opt/gobot
EnvironmentFile=/opt/gobot/.env
ExecStart=/opt/gobot/bin/irc-bot

Restart=on-failure
RestartSec=10
UMask=0077

# Send logs to journald.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
