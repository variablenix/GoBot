# For a one-network deployment, use the registered NickServ account/nick.
BOT_SASL_USER=GoBot
# Optional API/authentication secrets. Copy this file to .env.
BOT_SASL_PASS=replace-with-your-nickserv-password
# For CertFP/SASL EXTERNAL instead of password authentication:
# BOT_SASL_MECHANISM=external
# BOT_TLS_CLIENT_CERT=/opt/gobot/secrets/irc-client.pem
# BOT_TLS_CLIENT_KEY=
# One-time CertFP enrollment (keep PLAIN credentials above while enabled):
# BOT_CERTFP_ENROLL=true
# BOT_NICKSERV_NAME=NickServ
BOT_NEWS_API_KEY=replace-with-your-newsapi-key
BOT_YOUTUBE_API_KEY=replace-with-your-youtube-data-api-key
BOT_LASTFM_API_KEY=replace-with-your-lastfm-api-key
BOT_GITHUB_TOKEN=replace-with-an-optional-github-token
# Optional Opengist paste integration. Keep the token out of config.yaml.
BOT_PASTE_BASE_URL=https://paste.example.net
BOT_PASTE_TOKEN=replace-with-your-opengist-token
# !ask source and rewrite settings. Define each variable only once: duplicate
# environment keys can override earlier values in deployment loaders.
# Wolfram|Alpha sources are tried before the keyless fallbacks.
BOT_WOLFRAM_LLM_APPID=
BOT_WOLFRAM_APPID=
# Gemini rewrites retrieved source text into a concise natural-language answer.
BOT_ASK_PROVIDER=gemini
BOT_ASK_AI_REWRITE=true
BOT_GEMINI_API_KEY=
BOT_GEMINI_MODEL=gemini-3.6-flash
# Optional web-search fallback for current or relationship questions.
BOT_BRAVE_SEARCH_API_KEY=
# Optional alternatives; comment out Gemini settings and uncomment one provider
# as a complete pair if you intentionally switch providers.
# BOT_ASK_PROVIDER=openrouter
# BOT_OPENROUTER_API_KEY=
# A specific instruction-tuned free model is more consistent for rewrites.
# BOT_OPENROUTER_MODEL=google/gemma-4-31b-it:free
# BOT_ASK_PROVIDER=openai
# BOT_OPENAI_API_KEY=
# BOT_OPENAI_MODEL=gpt-4o-mini
# BOT_ASK_PROVIDER=ollama
# BOT_OLLAMA_URL=http://127.0.0.1:11434
# BOT_OLLAMA_MODEL=llama3.2
BOT_STORAGE_DB_PATH=./data/bot.db
BOT_STATS_LISTEN_ADDRESS=127.0.0.1:8082
